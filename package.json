{
  "name": "web-view",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node tools/i18n-check.mjs",
    "build": "ng build",
    "postbuild": "node tools/postbuild.mjs",
    "watch": "ng build --watch --configuration local",
    "test": "ng test",
    "lint": "ng lint",
    "preview:staging": "npm run build -- --configuration staging && node tools/cloudflare.mjs && wrangler dev --env staging",
    "deploy:staging": "npm run build -- --configuration staging && node tools/cloudflare.mjs && wrangler deploy --env staging",
    "i18n": "node tools/i18n-check.mjs && node tools/i18n-review.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/aria": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/platform-server": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/ssr": "^22.1.8",
    "@ngx-translate/core": "^18.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8",
    "wrangler": "^4.141.0"
  }
}
